+def responsive_candlesticks(source):
+    # Keep the accepted renderer and data; replace only its fixed coordinate box.
+    start = source.index('function My(')
+    end = source.index('function ', start + 1)
+    chart = source[start:end]
+    chart = once(chart, 'const b=Math.max(120,Math.round(p/Math.max(1,p)*p)),v=8',
+        'const plotNode=R.useRef(null),[plotSize,setPlotSize]=R.useState(null);R.useLayoutEffect(()=>observePlotSize(plotNode.current,setPlotSize),[!!a?.length]);const plotWidth=plotSize?.width||1e3,b=Math.max(120,plotSize?.height||p),v=8')
+    chart = once(chart, '(1e3-v-y)', '(plotWidth-v-y)')
+    chart = once(chart, 'Math.floor((W.clientX-Q.left)/Q.width*1e3/ve)',
+        'Math.floor(((W.clientX-Q.left)/Q.width*plotWidth-v)/ve)')
+    chart = once(chart, 'viewBox:`0 0 1000 ${b}`', 'ref:plotNode,viewBox:`0 0 ${plotWidth} ${b}`')
+    if chart.count('1e3-y') != 5:
+        raise ValueError('Unreviewed candlestick axis structure')
+    chart = chart.replace('1e3-y', 'plotWidth-y')
+    return source[:start] + chart + source[end:]
